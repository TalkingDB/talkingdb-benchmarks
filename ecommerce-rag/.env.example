# Copy this file to .env and fill in both values. .env is ignored by git.

# OpenAI API key, for the models the bot uses: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Hugging Face token (type "Read") from an account with access to the private dataset
# TalkingDB/ecommerce-rag: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
